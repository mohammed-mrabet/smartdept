# Copier ce fichier en .env puis adapter (docker compose le lit automatiquement)
DOCKERHUB_USER=votre-compte-dockerhub
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-plus-de-32-caracteres

# --- IA gratuite : choisir UNE des trois options ---
# 1) Ollama en local (docker compose --profile ai up -d, puis : docker compose exec ollama ollama pull llama3.2:3b)
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.2:3b
AI_API_KEY=
# 2) Groq (clé gratuite sur console.groq.com)
# AI_ENABLED=true
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant
# AI_API_KEY=gsk_...
# 3) Google Gemini (clé gratuite sur aistudio.google.com)
# AI_ENABLED=true
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
# AI_API_KEY=AIza...
