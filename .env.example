# Copier ce fichier en .env puis adapter (docker compose le lit automatiquement)
DOCKERHUB_USER=votre-compte-dockerhub
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-plus-de-32-caracteres

# --- E-mails réels (Gmail, Outlook, @ump.ac.ma…) ---
# Sans SMTP_HOST, tous les e-mails sont déposés dans Mailpit (http://localhost:8025).
# Avec SMTP_HOST : les vraies adresses reçoivent l'e-mail ; les adresses de démonstration (@smartdept.ma, @exemple.ma…)
# ou invalides vont dans Mailpit. MAIL_MODE=auto (défaut) | sandbox (tout dans Mailpit) | smtp (tout en réel)
MAIL_MODE=auto
# 1) Gmail : activer la validation en 2 étapes puis créer un « mot de passe d'application » (myaccount.google.com/apppasswords)
#    Limite : environ 500 e-mails par jour. L'expéditeur est votre adresse Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_USERNAME=votre.adresse@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop          (les 16 lettres du mot de passe d'application, sans espaces)
# 2) Brevo (gratuit, 300 e-mails par jour) : app.brevo.com → SMTP & API → créer une clé SMTP
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_USERNAME=xxxxxx@smtp-brevo.com
# SMTP_PASSWORD=xsmtpsib-...
# MAIL_FROM=SmartDept <adresse-verifiee-dans-brevo@gmail.com>
# Outlook.com / Hotmail : déconseillé, Microsoft supprime l'authentification SMTP par mot de passe (OAuth obligatoire).
#   Les adresses @outlook.com REÇOIVENT bien les e-mails envoyés par Gmail ou Brevo.

# --- IA gratuite : choisir UNE des trois options ---
# 1) Ollama en local (docker compose --profile ai up -d, puis : docker compose exec ollama ollama pull llama3.2:3b)
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.2:3b
AI_API_KEY=
# 2) Groq (clé gratuite sur console.groq.com)
# AI_ENABLED=true
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant
# AI_API_KEY=gsk_...
# 3) Google Gemini (clé gratuite sur aistudio.google.com)
# AI_ENABLED=true
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
# AI_API_KEY=AIza...

# --- Offres de stage : API gratuites (laisser vide celles que vous n'utilisez pas) ---
# Sans aucune clé, Remotive, Jobicy et Arbeitnow (télétravail) et les offres du département fonctionnent déjà.
# France · France Travail (francetravail.io → créer une application, API « Offres d'emploi v2 »)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# France · La bonne alternance (api.apprentissage.beta.gouv.fr → Mon compte → jeton)
LBA_API_KEY=
# France, Belgique, Espagne, Canada · Adzuna (developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Maroc + autres pays · Jooble (une clé par pays : ma.jooble.org/api/about, fr.jooble.org/api/about…)
JOOBLE_KEYS=MA:,FR:
# Maroc, France, Belgique, Espagne, Canada · Careerjet / Optioncarriere (compte éditeur)
CAREERJET_API_KEY=
CAREERJET_USER_IP=
# Espagne · InfoJobs (developer.infojobs.net)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
